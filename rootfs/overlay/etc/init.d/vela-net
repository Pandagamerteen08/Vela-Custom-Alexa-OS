#!/sbin/openrc-run
# vela-net — bring up wlan0 with wpa_supplicant 2.9, no dhcpcd, no D-Bus.
#
# The daemon normally spawns and owns the supplicant (so it can drive reconnects
# from cfg80211 events). This script exists for the case where the daemon is not
# running yet: bring-up, debugging, and the first boot that has to come up with a
# network before there is any UI to configure one.
#
# It is in the default runlevel, so boot order is: vela-boot (inittab sysinit)
# loads mt76x8_wlan, then this starts wlan0 from the credentials in
# /data/wifi.conf. Once velad exists it takes ownership of the supplicant and
# this service becomes a fallback.

description="cronos Wi-Fi (wpa_supplicant + udhcpc)"

depend() {
    need localmount
    after modules
    # `after`, not `need`: vela-boot is already executed from inittab's sysinit,
    # so `need vela-boot` would pull it into this runlevel and run it twice
    # (a second modprobe pass and a second blocking `ntpd -q`).
    after vela-boot
    provide net
}

start() {
    ebegin "starting wlan0"
    if ! ip link show wlan0 >/dev/null 2>&1; then
        ewarn "no wlan0 (mt76x8_wlan did not load)"
        eend 1
        return 1
    fi
    mkdir -p /run/wpa_supplicant

    # Credentials are not in the image: they are read from /data/wifi.conf and
    # turned into /run/wpa_supplicant.conf (0600) by this helper. No credentials
    # means no supplicant at all, which is better than one that cannot connect.
    if ! /usr/sbin/vela-wifi-config; then
        ewarn "Wi-Fi not provisioned: write /data/wifi.conf (SSID=... PSK=...) and restart"
        ewarn "  from the host: tools/deploy.sh wifi <ssid> <psk>"
        eend 1
        return 1
    fi

    # -u: don't touch the interface state behind our back
    # -Dnl80211: the vendor fullmac is cfg80211, not wext
    # -s: log to syslog; there is no syslogd, so it goes to the console ring
    # No -B: we want the pid, so we can stop it deterministically.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/wpa_supplicant.pid \
        --exec /usr/sbin/wpa_supplicant -- \
        -u -Dnl80211 -i wlan0 -c /run/wpa_supplicant.conf

    # DHCP: busybox udhcpc is transient (~200 KB for a second), not a daemon.
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/udhcpc.pid \
        --exec /sbin/udhcpc -- -i wlan0 -b -q -t 5 -T 3
    eend 0
}

stop() {
    ebegin "stopping wlan0"
    start-stop-daemon --stop --pidfile /run/udhcpc.pid 2>/dev/null
    start-stop-daemon --stop --pidfile /run/wpa_supplicant.pid 2>/dev/null
    eend 0
}
